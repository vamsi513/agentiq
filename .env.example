# AgentIQ — Environment Variables Template
# Copy this file to .env and fill in your real API keys.
# NEVER commit the real .env file — it is listed in .gitignore.

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Required: used for gpt-4o-mini generation and query routing
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Tavily Search ────────────────────────────────────────────────────────────
# Required for live web search tool (free tier: 1,000 searches/month)
# Get your key at: https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ── Application Settings ─────────────────────────────────────────────────────
# LLM model — gpt-4o-mini is cost-efficient and fast
OPENAI_MODEL=gpt-4o-mini

# Embedding model — runs locally, no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Maximum tokens for generation responses
MAX_TOKENS=1024

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.2

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# Number of documents to retrieve from FAISS
TOP_K_RETRIEVAL=5

# Number of web search results to fetch
MAX_WEB_RESULTS=5

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
