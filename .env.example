# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ── Model settings (optional — defaults shown) ────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_TOKENS=1024
TEMPERATURE=0.2

# ── Retrieval settings ────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=5
MAX_WEB_RESULTS=5

# ── LangSmith observability (optional) ───────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=agentiq

# ── Pinecone (optional — reference implementation only, not wired into the
#    live agent; see retrieval/pinecone_store.py) ─────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=agentiq-docs
PINECONE_ENV=us-east-1

# ── Server settings ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── API security (optional — unset means open/dev mode, see config.py) ────────
# Require X-API-Key: <value> on requests to the FastAPI /chat endpoints.
# Leave unset for unauthenticated access (fine for local dev/demo).
AGENTIQ_API_KEY=
# Comma-separated allowed CORS origins, e.g. https://myapp.com,http://localhost:8501
# Leave unset to allow all origins ("*") — fine for local dev/demo, not for production.
ALLOWED_ORIGINS=
# Comma-separated IPs of trusted reverse proxies allowed to set X-Forwarded-For.
# Defaults to 127.0.0.1 (localhost only) if unset.
TRUSTED_PROXY_IPS=127.0.0.1

# Per-run budgets. Off by default. With BUDGETS_ENABLED false nothing is
# enforced and the limits below are inert. A limit of 0 turns that one limit
# off even when enforcement is on. A run that reaches a limit stops and
# reports a status rather than failing.
# BUDGETS_ENABLED=false
# BUDGET_MAX_STEPS=12
# BUDGET_MAX_TOKENS=8000
# BUDGET_MAX_WALL_SECONDS=60
# Credential handling.
#
# REDACTION_ENABLED is ON by default. It installs a logging filter that masks
# credential shapes and this process's own configured secrets. It is on because
# node and tool level logs include the query at INFO and a user can paste a
# credential into a question. Set it to false only if you have a reason to.
#
# CREDENTIAL_BROKER_ENABLED is off by default. When on, the web search key is
# fetched against a scoped, short lived handle instead of being read from
# settings when the client is constructed.
# REDACTION_ENABLED=true
# CREDENTIAL_BROKER_ENABLED=false
# CREDENTIAL_TTL_SECONDS=300
# Tool audit log. Off by default. When on, each tool call writes one JSON line
# to the agentiq.audit logger: tool name, a bounded and redacted summary of the
# arguments, duration in milliseconds, and outcome (ok, fallback or error).
# Argument strings pass through the redaction filter before the record is
# built, and long values are recorded as a length plus a short head rather
# than copied, so a record stays small.
# AUDIT_LOG_ENABLED=false
